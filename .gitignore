# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
dist.prev.*
dist_exe/
.venv/
.venv-build/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# PyInstaller 自动生成的临时 spec 不入库；
# 但 packaging/cedas.spec 是手写的构建配置，必须入库（见下方例外）。
*.spec

# ---- 运行产物 ----
*.db
*.db-journal
*.log
output/

# ---- 打包中间产物：由 tools/build_offline.py 生成，可随时重建 ----
packaging/version_info.txt

# ---- 敏感数据：真实案件材料一律不入库 ----
data/samples/*
!data/samples/.gitkeep
data/truth/*
!data/truth/.gitkeep
data/output/*
!data/output/.gitkeep
data/*.xlsx
resources/templates/*.docx
resources/templates/*.doc

# ---- 系统与编辑器 ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp

# ---- 本地工作区元数据（不随仓库分发） ----
.workbuddy/

# ---- 例外：必须入库的构建配置 ----
!packaging/cedas.spec
