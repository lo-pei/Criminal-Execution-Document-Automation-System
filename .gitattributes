* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=crlf
*.ps1    text eol=crlf
*.bat    text eol=crlf

*.docx   binary
*.xlsx   binary
*.pdf    binary
*.png    binary
*.jpg    binary

# GitHub 语言统计：PyInstaller spec 本质是 Python 脚本，按 Python 计，
# 避免仓库语言条出现未识别的 "Other"。
packaging/*.spec linguist-language=Python
